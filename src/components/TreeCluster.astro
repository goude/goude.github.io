---
/* Small pine-cluster line-art placeholder, echoing HeroIllustration's
   tree marks. Used near the closing paragraph on the homepage. */
---

<svg
  class="tree-cluster"
  viewBox="0 0 160 90"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="var(--text-muted)" stroke-width="1.5" fill="none">
    <path d="M40 82 v-46 M40 62 l-17 -17 M40 46 l17 -17 M40 34 l-14 -14"></path>
    <path d="M84 84 v-36 M84 68 l-13 -13 M84 54 l13 -13"></path>
    <path d="M118 80 v-40 M118 62 l-15 -15 M118 47 l15 -15 M118 36 l-12 -12"
    ></path>
  </g>
  <path
    d="M8 84 q20 -10 40 -2 q22 -12 44 0 q20 -8 40 -1 q16 -6 20 3"
    fill="none"
    stroke="var(--rule)"
    stroke-width="1.5"></path>
  <circle
    cx="14"
    cy="70"
    r="3"
    fill="none"
    stroke="var(--rule)"
    stroke-width="1.5"></circle>
  <circle
    cx="140"
    cy="74"
    r="2.5"
    fill="none"
    stroke="var(--rule)"
    stroke-width="1.5"></circle>
</svg>

<style>
  .tree-cluster {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
