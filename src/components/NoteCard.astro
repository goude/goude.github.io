---
interface Props {
  date?: string | undefined;
  title: string;
  href?: string | undefined;
  tilt?: number | undefined;
  alt?: boolean | undefined;
  tape?: boolean | undefined;
  thumb?: "sketch" | "svg" | "photo" | undefined;
}

const {
  date,
  title,
  href,
  tilt = -1,
  alt = false,
  tape = true,
  thumb,
} = Astro.props;
const thumbTilt = thumb === "photo" ? 1.5 : -2;
---

<article
  class:list={["note-card", "is-tilted", { "note-card--alt": alt }]}
  style={`--tilt:${tilt}deg`}
>
  {tape && <span class="tape" aria-hidden="true" />}
  <div class="note-card__row">
    <div class="note-card__body">
      {date && <p class="paper-label">{date}</p>}
      <h3>
        {
          href ? (
            <a href={href} class="paper-title-link">
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      <div class="paper-typewriter">
        <slot />
      </div>
    </div>
    {
      thumb && (
        <div
          class={`paper-thumb paper-thumb--${thumb}`}
          style={`--tilt:${thumbTilt}deg`}
          aria-hidden="true"
        >
          <span class="paper-thumb__label">{thumb}</span>
        </div>
      )
    }
  </div>
</article>
