---
interface Props {
  date?: string | undefined;
  title: string;
  tilt?: number | undefined;
  alt?: boolean | undefined;
  tape?: boolean | undefined;
}

const { date, title, tilt = -1, alt = false, tape = true } = Astro.props;
---

<article
  class:list={["note-card", "is-tilted", { "note-card--alt": alt }]}
  style={`--tilt:${tilt}deg`}
>
  {tape && <span class="tape" aria-hidden="true" />}
  {date && <p class="paper-label">{date}</p>}
  <h3
    style="font-family:var(--paper-font-type);font-size:20px;font-weight:400;margin:0 0 14px;color:var(--paper-ink-strong);"
  >
    {title}
  </h3>
  <div class="paper-typewriter">
    <slot />
  </div>
</article>
