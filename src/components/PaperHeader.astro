---
import { PAPER_NAV_INTERNAL, PAPER_NAV_EXTERNAL } from "@/types/site";

interface Props {
  current?: string | undefined;
}

const { current = "" } = Astro.props;
const currentHref = `/${current}`;
---

<div
  class="paper-width"
  style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:14px;"
>
  <span
    class="paper-eyebrow"
    style="margin:0;color:var(--paper-leather-fg);opacity:.72;"
    >Field Notes &amp; Findings</span
  >
  <button
    type="button"
    class="paper-nav-toggle"
    aria-expanded="false"
    aria-controls="paper-nav"
    aria-label="Toggle navigation"
  >
    &#9776;
  </button>
</div>

<nav id="paper-nav" class="paper-nav" aria-label="Main navigation">
  <div class="paper-nav__group">
    {
      PAPER_NAV_INTERNAL.map((item) => (
        <a
          href={item.href}
          aria-current={item.href === currentHref ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
  <div class="paper-nav__group paper-nav__group--external">
    {
      PAPER_NAV_EXTERNAL.map((item) => (
        <a href={item.href} target="_blank" rel="noopener noreferrer">
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".paper-nav-toggle");
  const nav = document.getElementById("paper-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
