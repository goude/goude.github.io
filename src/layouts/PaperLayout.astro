---
import "@/styles/paper.css";
import BaseHead from "@/components/BaseHead.astro";
import PaperHeader from "@/components/PaperHeader.astro";
import PaperFooter from "@/components/PaperFooter.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { PAPER_NAV_INTERNAL, type Breadcrumb } from "@/types/site";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  current?: string | undefined;
  /** Label for the deepest crumb on a detail/list page (e.g. a note's own
   * title, or "Not found"). Omit on Home and the section-list pages,
   * where the section itself is the deepest crumb. */
  crumb?: string | undefined;
}

const { title, description, current, crumb } = Astro.props;

const siteName = "goude.se";
const author = "doitpoorly";

const fullTitle = title
  ? `${title} · ${siteName} · ${author}`
  : `${siteName} · ${author}`;

const section = PAPER_NAV_INTERNAL.find((n) => n.href === `/${current}`);

const crumbs: Breadcrumb[] =
  current === ""
    ? [{ label: "Home" }]
    : [
        { label: "Home", href: "/" },
        ...(section && crumb ? [section] : []),
        { label: crumb ?? section?.label ?? "Not found" },
      ];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} />
  </head>
  <body data-paper>
    <div class="paper-shell">
      <PaperHeader current={current} />
      <Breadcrumbs crumbs={crumbs} />
      <main class="paper-width">
        <slot />
      </main>
      <PaperFooter />
    </div>
  </body>
</html>
