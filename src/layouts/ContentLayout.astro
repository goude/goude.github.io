---
import PaperLayout from "@/layouts/PaperLayout.astro";
import NoteCard from "@/components/NoteCard.astro";
import Lightbox from "@/components/Lightbox.astro";

interface Frontmatter {
  title: string;
  description: string;
  created?: string;
  updated?: string;
}

const { frontmatter, url } = Astro.props as {
  frontmatter: Frontmatter;
  url: string;
};

// The root URL has no segment: Home is a page, but lives at "/" with current="".
const segment = url.split("/")[1] ?? "";
const section =
  segment === "essays" || segment === "pages" || segment === ""
    ? segment
    : "notes";
---

<PaperLayout
  title={frontmatter.title}
  description={frontmatter.description}
  current={section}
  crumb={frontmatter.title}
>
  {
    section === "notes" ? (
      <NoteCard title={frontmatter.title} date={frontmatter.updated} tilt={0}>
        <div class="paper-prose">
          <slot />
        </div>
      </NoteCard>
    ) : (
      <article
        class:list={[
          "paper-panel paper-prose",
          { "paper-essay-panel": section === "essays" },
        ]}
      >
        {section === "essays" ? (
          <>
            <p class="paper-eyebrow paper-eyebrow--center">Set in type</p>
            <h1 class="paper-h paper-h-panel">{frontmatter.title}</h1>
          </>
        ) : (
          <h1 class="paper-h paper-h-page">{frontmatter.title}</h1>
        )}
        <slot />
      </article>
    )
  }
  <Lightbox />
</PaperLayout>
