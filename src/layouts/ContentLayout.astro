---
import PaperLayout from "@/layouts/PaperLayout.astro";
import NoteCard from "@/components/NoteCard.astro";
import Lightbox from "@/components/Lightbox.astro";

interface Frontmatter {
  title: string;
  description: string;
  date: string;
}

const { frontmatter, url } = Astro.props as {
  frontmatter: Frontmatter;
  url: string;
};

const section = url.split("/")[1] === "essays" ? "essays" : "notes";
---

<PaperLayout
  title={frontmatter.title}
  description={frontmatter.description}
  current={section}
  crumb={frontmatter.title}
>
  {
    section === "notes" ? (
      <NoteCard title={frontmatter.title} date={frontmatter.date} tilt={0}>
        <div class="paper-prose">
          <slot />
        </div>
      </NoteCard>
    ) : (
      <article class="paper-panel paper-prose paper-essay-panel">
        <slot />
      </article>
    )
  }
  <Lightbox />
</PaperLayout>
