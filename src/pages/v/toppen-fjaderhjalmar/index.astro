---

<PaperLayout
  title="Toppen fjäderhjälmar"
  description="A misheard Swedish poem, synced word-by-word to the video that misheard it."
  current="v/toppen-fjaderhjalmar"
>
  <article class="paper-panel">
    <p class="paper-eyebrow">Toppen fjäderhjälmar</p>
    <p
      style="font-family:var(--paper-font-serif);font-style:italic;color:var(--paper-ink-muted);margin:0 0 24px;font-size:15px;"
    >
      Swedish phonetic transcription of Guðmundur Benediktsson's Icelandic
      commentary, Iceland 2–1 Austria, Euro 2016 — transcription by
      <a
        href="https://www.reddit.com/user/zimonitrome/"
        target="_blank"
        rel="noopener">zimonitrome</a
      >.
    </p>

    <video
      id="v"
      controls
      preload="metadata"
      playsinline
      style="width:100%;max-width:640px;display:block;margin:0 auto 24px;"
    >
      <source
        src="https://pub-297728e859704112a190147db3fefac6.r2.dev/toppen-fjaderhjalmar-web.webm"
        type="video/webm"
      />
      <source
        src="https://pub-297728e859704112a190147db3fefac6.r2.dev/toppen-fjaderhjalmar-web.mp4"
        type="video/mp4"
      />
    </video>

    <div class="poem">
      {
        lines.map((line) => (
          <p class="poem-line">
            {line.words.map(([word, t]) => (
              <span class="word" data-t={t}>
                {word}
              </span>
            ))}
          </p>
        ))
      }
    </div>
  </article>
</PaperLayout>

<style>
  .poem {
    font-family: var(--paper-font-serif);
    font-size: 19px;
    line-height: 1.9;
  }
  .poem-line {
    margin: 0 0 4px;
  }
  .word {
    cursor: pointer;
    padding: 0 2px;
    border-radius: 2px;
  }
  .word:hover {
    background: rgba(80, 60, 40, 0.12);
  }
  .word.current {
    background: var(--paper-leather-fg, #7a5230);
    color: #fff;
  }
  .word.past {
    opacity: 0.45;
  }
</style>

<script>
  const video = document.getElementById("v") as HTMLVideoElement;
  const words = Array.from(document.querySelectorAll<HTMLElement>(".word")).map(
    (el) => ({ el, t: parseFloat(el.dataset.t ?? "0") })
  );

  words.forEach(({ el, t }) => {
    el.addEventListener("click", () => {
      video.currentTime = t;
      video.play().catch(() => {});
    });
  });

  video.addEventListener("timeupdate", () => {
    const now = video.currentTime;
    for (const { el, t } of words) {
      el.classList.toggle("current", t <= now + 0.2 && t > now - 0.5);
      el.classList.toggle("past", t <= now - 0.5);
    }
  });
</script>
