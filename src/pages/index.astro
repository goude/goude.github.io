---
import PaperLayout from "@/layouts/PaperLayout.astro";

interface TocEntry {
  n: string;
  label: string;
  sub: string;
  href: string;
}

const toc: TocEntry[] = [
  {
    n: "I",
    label: "Notes",
    sub: "typed entries, longer than a jotting",
    href: "/notes",
  },
  {
    n: "II",
    label: "Essays",
    sub: "writeups, set in type",
    href: "/essays",
  },
  {
    n: "—",
    label: "Archive",
    sub: "everything from before this reorg",
    href: "/archive",
  },
];
---

<PaperLayout
  title="Index"
  description="goude.se — reorg in progress. Notes and essays, gathered as they're found."
  current=""
>
  <article class="paper-panel">
    <p class="paper-eyebrow">Table of contents</p>
    <h2 class="paper-h" style="font-size:clamp(34px,6vw,52px);margin:0 0 34px;">
      Index
    </h2>
    {
      toc.map((e) => (
        <a
          href={e.href}
          style="display:flex;width:100%;align-items:baseline;gap:12px;padding:14px 0;text-align:left;border-top:1px solid rgba(80,60,40,.18);border-bottom:none;"
        >
          <span style="font-family:var(--paper-font-type);font-size:12px;color:var(--paper-ink-label-dim);width:34px;flex:none;">
            {e.n}
          </span>
          <span style="display:flex;flex-direction:column;gap:2px;flex:none;max-width:70%;">
            <span style="font-family:var(--paper-font-serif);font-size:23px;color:var(--paper-ink-strong);">
              {e.label}
            </span>
            <span style="font-family:var(--paper-font-type);font-size:11px;letter-spacing:1px;color:var(--paper-ink-label);">
              {e.sub}
            </span>
          </span>
          <span style="flex:1;border-bottom:1.5px dotted rgba(80,60,40,.4);transform:translateY(-5px);" />
        </a>
      ))
    }
    <p
      style="font-family:var(--paper-font-serif);font-style:italic;color:var(--paper-ink-muted);margin:34px 0 0;font-size:17px;"
    >
      Reorg in progress. Entries are added as they are found.
    </p>
  </article>
</PaperLayout>
