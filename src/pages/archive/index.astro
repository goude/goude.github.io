---
import PaperLayout from "@/layouts/PaperLayout.astro";

interface ArchiveEntry {
  href: string;
  title: string;
}

interface ArchiveGroup {
  label: string;
  note: string;
  entries: ArchiveEntry[];
}

const groups: ArchiveGroup[] = [
  {
    label: "Essays & pieces (AI-generated)",
    note: "Written with AI assistance, from before this reorg.",
    entries: [
      {
        href: "/ai-generated/ambient-improvement-positive-residue",
        title: "Ambient Improvement",
      },
      { href: "/ai-generated/computers", title: "Computers" },
      { href: "/ai-generated/knowledge", title: "Knowledge Base" },
      { href: "/ai-generated/markup", title: "Markup Test" },
      { href: "/ai-generated/notes", title: "Notes" },
      { href: "/ai-generated/old-entry-point", title: "Old Entry Point" },
      { href: "/ai-generated/old-hello", title: "Old Hello" },
      { href: "/ai-generated/typewriter", title: "Typewriter" },
      {
        href: "/ai-generated/beat-learn",
        title: "Notes – Digitakt Beat Practice Ladder",
      },
      {
        href: "/ai-generated/do-olls-that-will-talk",
        title: "The Do-olls That Will Talk",
      },
      { href: "/ai-generated/energy", title: "Energy" },
      { href: "/ai-generated/no-bullshit", title: "No Bullshit" },
      { href: "/ai-generated/opening-the-hood", title: "Opening the Hood" },
      {
        href: "/ai-generated/patch-learn",
        title: "Notes – Novation Peak Sound Design Practice Ladder",
      },
      { href: "/ai-generated/sheev", title: "GoatTracker2 on macOS" },
      { href: "/ai-generated/thread-taxonomy", title: "Thread Taxonomy" },
      { href: "/ai-generated/wall-of-sound", title: "The Wall of Sound" },
    ],
  },
  {
    label: "Tools",
    note: "Small working utilities, not writeups.",
    entries: [
      { href: "/cop", title: "cop — cloud clipboard portal" },
      { href: "/egghunt", title: "egghunt" },
    ],
  },
  {
    label: "Docs",
    note: "Project/dev documentation about this site's own build.",
    entries: [{ href: "/docs", title: "docs" }],
  },
  {
    label: "Superseded",
    note: "Replaced by this reorg.",
    entries: [
      { href: "/hello", title: "Hello (old placeholder)" },
      { href: "/archive/notes-md", title: "NOTES.md (dev-philosophy page)" },
    ],
  },
];
---

<PaperLayout
  title="Archive"
  description="Everything from before this reorg, kept live at its original address."
  current="archive"
>
  <article class="paper-panel">
    <p class="paper-eyebrow">Kept, not thrown away</p>
    <h2 class="paper-h" style="font-size:clamp(34px,6vw,52px);margin:0 0 12px;">
      Archive
    </h2>
    <p
      style="font-family:var(--paper-font-serif);font-style:italic;color:var(--paper-ink-muted);margin:0 0 34px;font-size:17px;"
    >
      Nothing here moved or changed — these are the site's old pages, still live
      at their original addresses, just off the main nav now.
    </p>

    {
      groups.map((g) => (
        <section style="margin-bottom:32px;">
          <h3 style="font-family:var(--paper-font-serif-sc);font-weight:400;font-size:20px;color:var(--paper-ink-strong);margin:0 0 4px;">
            {g.label}
          </h3>
          <p style="font-family:var(--paper-font-type);font-size:11px;letter-spacing:1px;color:var(--paper-ink-label);margin:0 0 14px;">
            {g.note}
          </p>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;">
            {g.entries.map((e) => (
              <li style="border-top:1px solid rgba(80,60,40,.15);">
                <a
                  href={e.href}
                  style="display:block;padding:9px 0;font-family:var(--paper-font-serif);font-size:17px;color:var(--paper-ink-strong);"
                >
                  {e.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</PaperLayout>
