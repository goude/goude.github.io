---
import PaperLayout from "@/layouts/PaperLayout.astro";
---

<PaperLayout
  title="Essays"
  description="Essays — writeups, set in type."
  current="essays"
>
  <header
    style="text-align:center;color:var(--paper-leather-fg);margin-bottom:26px;"
  >
    <p class="paper-eyebrow" style="opacity:.7;color:inherit;">Section II</p>
    <h2 class="paper-h" style="font-size:clamp(30px,6vw,46px);color:inherit;">
      Essays
    </h2>
  </header>

  <article
    class="paper-panel"
    style="max-width:var(--paper-essay-max);margin:0 auto;"
  >
    <p class="paper-eyebrow" style="text-align:center;">Set in type</p>
    <h2
      class="paper-h"
      style="font-size:clamp(28px,5vw,40px);text-align:center;margin-bottom:20px;"
    >
      First entry
    </h2>
    <p class="paper-essay">
      Nothing here yet. This page exists to prove the Essays template works —
      the first real essay replaces it.
    </p>
    <p style="margin:20px 0 0;text-align:center;">
      <a href="/essays/first">Open →</a>
    </p>
  </article>
</PaperLayout>
