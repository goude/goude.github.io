---
import PaperLayout from "@/layouts/PaperLayout.astro";
import { toEntries } from "@/utils/entries";

interface Meta {
  title: string;
  description: string;
  created: string;
  updated: string;
  thumb?: "sketch" | "svg" | "photo";
}

const modules = import.meta.glob<{ frontmatter: Meta }>("./*.{md,astro}", {
  eager: true,
});

// Newest update first; ties keep A to Z.
const entries = toEntries(modules, "essays").sort(
  (a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title)
);
---

<PaperLayout
  title="Essays"
  description="Essays — writeups, set in type."
  current="essays"
>
  <header class="paper-section-header">
    <p class="paper-eyebrow">Section III</p>
    <h1 class="paper-h paper-h-section">Essays</h1>
  </header>

  <div class="paper-stack">
    {
      entries.map((e) => (
        <article class="paper-panel paper-essay-panel">
          <p class="paper-eyebrow paper-eyebrow--center">Set in type</p>
          <h2 class="paper-h paper-h-panel">
            <a href={e.href} class="paper-title-link">
              {e.title}
            </a>
          </h2>
          <p class="paper-essay">{e.description}</p>
          {e.thumb && (
            <div
              class={`paper-thumb paper-thumb--wide paper-thumb--${e.thumb}`}
              aria-hidden="true"
            >
              <span class="paper-thumb__label">
                {e.thumb === "photo" ? "plate" : e.thumb}
              </span>
            </div>
          )}
          <p style="margin:20px 0 0;text-align:center;">
            <a href={e.href}>Open →</a>
          </p>
        </article>
      ))
    }
  </div>
</PaperLayout>
