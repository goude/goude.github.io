---
import PaperLayout from "@/layouts/PaperLayout.astro";

export const frontmatter = {
  title: "First entry",
  description: "Placeholder — the first real essay goes here.",
  date: "2026-09-05",
};
---

<PaperLayout
  title={frontmatter.title}
  description={frontmatter.description}
  current="essays"
>
  <p class="paper-back-link">
    <a href="/essays">← Essays</a>
  </p>
  <article class="paper-panel paper-essay-panel">
    <p class="paper-eyebrow paper-eyebrow--center">Set in type</p>
    <h2 class="paper-h paper-h-panel">{frontmatter.title}</h2>
    <p class="paper-essay">
      Placeholder entry — nothing written yet. This page exists to prove the
      Essays template works before any real content is added.
    </p>
    <p class="paper-essay">
      See also <a href="/essays/placeholder-two">placeholder essay II</a>.
    </p>
  </article>
</PaperLayout>
