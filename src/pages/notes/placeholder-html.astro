---
import PaperLayout from "@/layouts/PaperLayout.astro";
import NoteCard from "@/components/NoteCard.astro";

export const frontmatter = {
  title: "Placeholder note (HTML)",
  description: "Placeholder — the HTML-authored note option.",
  date: "2026-09-05",
};
---

<PaperLayout
  title={frontmatter.title}
  description={frontmatter.description}
  current="notes"
>
  <p style="margin:0 0 20px;">
    <a href="/notes">← Notes</a>
  </p>
  <NoteCard title={frontmatter.title} date="5 September 2026" tilt={0}>
    <p style="margin:0;">
      Placeholder — replace with real content. This note is a full Astro page
      rather than markdown, for when a note needs bespoke layout or
      interactivity. See also
      <a href="/notes/placeholder">the markdown placeholder note</a>.
    </p>
  </NoteCard>
</PaperLayout>
