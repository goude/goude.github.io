---
import PaperLayout from "@/layouts/PaperLayout.astro";
import NoteCard from "@/components/NoteCard.astro";

interface Meta {
  title: string;
  description: string;
  date: string;
}

const modules = import.meta.glob<{ frontmatter: Meta }>("./*.{md,astro}", {
  eager: true,
});

const entries = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path
      .split("/")
      .pop()!
      .replace(/\.(md|astro)$/, "");
    return { href: `/notes/${slug}`, ...mod.frontmatter };
  })
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<PaperLayout
  title="Notes"
  description="Field notes — typed entries, longer than a jotting."
  current="notes"
>
  <header
    style="text-align:center;color:var(--paper-leather-fg);margin-bottom:26px;"
  >
    <p class="paper-eyebrow" style="opacity:.7;color:inherit;">Section I</p>
    <h2 class="paper-h" style="font-size:clamp(30px,6vw,46px);color:inherit;">
      Notes
    </h2>
  </header>

  <div style="display:flex;flex-direction:column;gap:34px;">
    {
      entries.map((e, i) => (
        <NoteCard title={e.title} date={fmt(e.date)} tilt={i % 2 ? 1.2 : -1.2}>
          <p style="margin:0;">{e.description}</p>
          <p style="margin:14px 0 0;">
            <a href={e.href}>Open →</a>
          </p>
        </NoteCard>
      ))
    }
  </div>
</PaperLayout>
