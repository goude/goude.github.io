---
import PaperLayout from "@/layouts/PaperLayout.astro";
import { toEntries } from "@/utils/entries";
import NoteCard from "@/components/NoteCard.astro";

interface Meta {
  title: string;
  description: string;
  created: string;
  updated: string;
  thumb?: "sketch" | "svg" | "photo";
}

const modules = import.meta.glob<{ frontmatter: Meta }>("./*.{md,astro}", {
  eager: true,
});

// Newest update first; ties keep A to Z.
const entries = toEntries(modules, "notes").sort(
  (a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title)
);
---

<PaperLayout
  title="Notes"
  description="Field notes — typed entries, longer than a jotting."
  current="notes"
>
  <header class="paper-section-header">
    <p class="paper-eyebrow">Section II</p>
    <h1 class="paper-h paper-h-section">Notes</h1>
  </header>

  <div class="paper-stack">
    {
      entries.map((e, i) => (
        <NoteCard
          title={e.title}
          href={e.href}
          date={e.updated}
          tilt={i % 2 ? 1.2 : -1.2}
          thumb={e.thumb}
        >
          <p style="margin:0;">{e.description}</p>
          <p style="margin:14px 0 0;">
            <a href={e.href}>Open →</a>
          </p>
        </NoteCard>
      ))
    }
  </div>
</PaperLayout>
